# Live LLM step (#4). Copy what you need into your shell (there is no .env loader):
#   export $(grep -v '^#' demo/.env.example | xargs)   # then set a real credential

# Gateway or direct. Unset means https://api.anthropic.com.
ANTHROPIC_BASE_URL=http://localhost:8080/anthropic

# One of these. A bearer token is what the gateway uses.
ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Optional model override (default claude-sonnet-5-5).
# LLM_MODEL=claude-sonnet-5-5
